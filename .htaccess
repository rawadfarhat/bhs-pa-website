DirectoryIndex index.php
Options -Indexes

<FilesMatch "^(config\.php|config\.php\.example|README\.md)$">
    Require all denied
</FilesMatch>

RewriteEngine On
RewriteRule ^index\.html$ index.php [R=301,L]
RewriteRule ^pa_members\.html$ pa-members.php [R=301,L]
RewriteRule ^subscribe\.html$ subscribe.php [R=301,L]
RewriteRule ^terms\.html$ terms.php [R=301,L]
RewriteRule ^festival_of_peace_2026\.html$ festival-of-peace-2026.php [R=301,L]

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

